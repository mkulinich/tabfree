# Copy to terraform.tfvars (gitignored) and adjust. Every value has a default,
# so an empty file works. No secrets belong here: database passwords are
# generated by AWS and kept in Secrets Manager.

region      = "us-east-1"
name_prefix = "tabfree"
environment = "sandbox"

# Refuse to run against any other account (recommended).
# allowed_account_ids = ["<sandbox-account-id>"]

tags = {
  Owner = "<team-or-person>"
}

# --- Cost profile ---------------------------------------------------------
# Defaults: single NAT gateway on, Aurora always on at 0.5 ACU, no Redshift.
# Cheapest idle sandbox (no outbound internet from private subnets, Aurora
# pauses after an hour idle and takes ~15 s or more to resume):
# enable_nat_gateway  = false
# aurora_min_capacity = 0

aurora_max_capacity = 2

# Redshift Serverless for engine comparisons (P1.16, P2.10). Free while idle.
# AWS documents three AZs for Redshift Serverless subnets.
# enable_redshift        = true
# redshift_base_capacity = 4
# az_count               = 3

# Athena guardrails.
athena_bytes_scanned_cutoff_per_query = 10737418240 # 10 GiB per query
athena_results_retention_days         = 7

# Teardown: set these, apply, then destroy.
# aurora_deletion_protection = false
# force_destroy              = true
