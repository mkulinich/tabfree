# Security foundations (BUILD_PLAN P7.3): one customer-managed KMS key for TabFree's data at rest
# (Aurora, S3, CloudWatch Logs, Secrets Manager, backups), with yearly rotation, and the application's
# signing keys generated into Secrets Manager. Nothing secret is written to tfvars or the repository;
# the values live in state (keep state encrypted, e.g. the S3 backend with encrypt = true).

data "aws_caller_identity" "current" {}
data "aws_region" "current" {}
data "aws_partition" "current" {}

locals {
  account = data.aws_caller_identity.current.account_id
  region  = data.aws_region.current.region
  root    = "arn:${data.aws_partition.current.partition}:iam::${local.account}:root"
  secrets = toset(["link-signing-key", "oauth-signing-key", "frame-signing-key"])
}

data "aws_iam_policy_document" "key" {
  statement {
    sid       = "AccountAdministers"
    actions   = ["kms:*"]
    resources = ["*"]
    principals {
      type        = "AWS"
      identifiers = [local.root]
    }
  }

  statement {
    sid       = "CloudWatchLogs"
    actions   = ["kms:Encrypt*", "kms:Decrypt*", "kms:ReEncrypt*", "kms:GenerateDataKey*", "kms:Describe*"]
    resources = ["*"]
    principals {
      type        = "Service"
      identifiers = ["logs.${local.region}.amazonaws.com"]
    }
    condition {
      test     = "ArnLike"
      variable = "kms:EncryptionContext:aws:logs:arn"
      values   = ["arn:${data.aws_partition.current.partition}:logs:${local.region}:${local.account}:*"]
    }
  }
}

resource "aws_kms_key" "this" {
  description             = "TabFree ${var.name}: data at rest"
  enable_key_rotation     = true
  rotation_period_in_days = 365
  deletion_window_in_days = var.deletion_window_days
  policy                  = data.aws_iam_policy_document.key.json
}

resource "aws_kms_alias" "this" {
  name          = "alias/${var.name}"
  target_key_id = aws_kms_key.this.key_id
}

resource "random_password" "app" {
  for_each = local.secrets

  length  = 48
  special = false
}

resource "aws_secretsmanager_secret" "app" {
  for_each = local.secrets

  name                    = "${var.name}/${each.key}"
  description             = "TabFree ${each.key} (generated by OpenTofu)"
  kms_key_id              = aws_kms_key.this.arn
  recovery_window_in_days = var.secret_recovery_days
}

resource "aws_secretsmanager_secret_version" "app" {
  for_each = local.secrets

  secret_id     = aws_secretsmanager_secret.app[each.key].id
  secret_string = random_password.app[each.key].result
}
