{
  "name": "@tabfree/runtime",
  "version": "0.0.1",
  "description": "TabFree dashboard runtime: sandbox protocol, host bridge, dashboard SDK and the <tf-*> components.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "import": "./dist/host.js"
    },
    "./bundle/frame.js": "./dist/bundle/frame.js",
    "./bundle/host.js": "./dist/bundle/host.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build && TABFREE_BUNDLE=host vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "happy-dom": "^21.0.4",
    "vite": "^8.3.6"
  }
}
