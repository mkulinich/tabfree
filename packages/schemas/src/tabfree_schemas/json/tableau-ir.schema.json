{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tabfree:schema:tableau-ir:0",
  "title": "TabFree Tableau intermediate representation (IR)",
  "description": "A faithful, JSON-friendly representation of a Tableau workbook (.twb/.twbx) or data source (.tds/.tdsx), produced by the TWB parser (BUILD_PLAN P2.1). It keeps Tableau's own names and encodings (for example field references such as [federated.x].[sum:Sales:qk]) so that downstream steps can generate semantic models, query manifests and dashboards deterministically. Credentials are never captured.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "source", "datasources"],
  "properties": {
    "schema": { "const": "tabfree/tableau-ir@0" },
    "kind": { "enum": ["workbook", "datasource"] },
    "source": { "$ref": "#/$defs/source" },
    "datasources": { "type": "array", "items": { "$ref": "#/$defs/datasource" } },
    "parameters": {
      "description": "Columns of Tableau's special \"Parameters\" data source.",
      "type": "array",
      "items": { "$ref": "#/$defs/column" }
    },
    "worksheets": { "type": "array", "items": { "$ref": "#/$defs/worksheet" } },
    "dashboards": { "type": "array", "items": { "$ref": "#/$defs/dashboard" } },
    "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } },
    "stories": { "type": "array", "items": { "$ref": "#/$defs/story" } },
    "notes": {
      "description": "Parser diagnostics: unsupported or partially understood constructs.",
      "type": "array",
      "items": { "$ref": "#/$defs/note" }
    }
  },
  "$defs": {
    "raw": {
      "description": "Untranslated attributes kept verbatim from the XML for later stages.",
      "type": "object"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "sha256", "parser", "parsedAt"],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "packaged": { "description": "True for .twbx/.tdsx packages.", "type": "boolean" },
        "sourceBuild": { "description": "The root element's source-build attribute (the reliable version signal).", "type": "string" },
        "sourcePlatform": { "type": "string" },
        "version": { "description": "The root element's version attribute (often stale, e.g. 18.1).", "type": "string" },
        "parser": { "type": "string" },
        "parsedAt": { "type": "string", "format": "date-time" },
        "tableau": {
          "description": "Where the file came from on Tableau Server, when known.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "server": { "type": "string" },
            "site": { "type": "string" },
            "luid": { "type": "string" },
            "contentUrl": { "type": "string" },
            "project": { "type": "string" },
            "updatedAt": { "type": "string", "format": "date-time" }
          }
        }
      }
    },
    "connection": {
      "description": "A connection element. Passwords and tokens are never captured.",
      "type": "object",
      "additionalProperties": false,
      "required": ["class"],
      "properties": {
        "name": { "type": "string" },
        "class": { "description": "Tableau connection class, e.g. redshift, athena, sqlserver, excel-direct, textscan, hyper, sqlproxy, federated.", "type": "string" },
        "caption": { "type": "string" },
        "server": { "type": "string" },
        "port": { "type": ["string", "integer"] },
        "dbname": { "type": "string" },
        "schema": { "type": "string" },
        "warehouse": { "type": "string" },
        "username": { "type": "string" },
        "authentication": { "type": "string" },
        "filename": { "type": "string" },
        "initialSql": { "type": "string" },
        "attributes": { "type": "object", "additionalProperties": { "type": "string" } }
      },
      "not": {
        "anyOf": [
          { "required": ["password"] },
          { "properties": { "attributes": { "anyOf": [{ "required": ["password"] }, { "required": ["token"] }] } }, "required": ["attributes"] }
        ]
      }
    },
    "relation": {
      "description": "Physical layer relation tree (table, join, union, custom SQL, pivot...).",
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["table", "join", "union", "text", "pivot", "collection", "stored-proc", "other"] },
        "name": { "type": "string" },
        "connection": { "type": "string" },
        "table": { "type": "string" },
        "sql": { "description": "Custom SQL text for type = text.", "type": "string" },
        "join": { "enum": ["inner", "left", "right", "full"] },
        "on": { "description": "Join clause, kept as Tableau's expression tree.", "type": ["object", "string"] },
        "children": { "type": "array", "items": { "$ref": "#/$defs/relation" } },
        "raw": { "$ref": "#/$defs/raw" }
      }
    },
    "objectGraph": {
      "description": "Tableau 2020.2+ logical layer (relationships between logical tables).",
      "type": "object",
      "additionalProperties": false,
      "required": ["objects"],
      "properties": {
        "objects": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "relation"],
            "properties": {
              "id": { "type": "string" },
              "caption": { "type": "string" },
              "relation": { "$ref": "#/$defs/relation" }
            }
          }
        },
        "relationships": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["first", "second"],
            "properties": {
              "first": { "type": "string" },
              "second": { "type": "string" },
              "expression": { "type": ["object", "string"] },
              "cardinality": { "type": "object" },
              "integrity": { "type": "object" }
            }
          }
        }
      }
    },
    "calculation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class"],
      "properties": {
        "class": { "description": "tableau, categorical-bin, quantitative-bin, ...", "type": "string" },
        "formula": { "type": "string" },
        "ast": { "description": "Parsed formula, filled in by the compiler front end.", "type": "object" },
        "usesUserFunctions": { "description": "USERNAME(), ISMEMBEROF() etc.: a row-level security signal.", "type": "boolean" },
        "lod": { "type": "boolean" },
        "tableCalc": { "type": "boolean" },
        "raw": { "$ref": "#/$defs/raw" }
      }
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "description": "Bracketed internal name, e.g. [Sales] or [Calculation_123].", "type": "string" },
        "caption": { "type": "string" },
        "datatype": { "enum": ["string", "integer", "real", "boolean", "date", "datetime", "spatial", "table", "unknown"] },
        "role": { "enum": ["dimension", "measure"] },
        "type": { "enum": ["nominal", "ordinal", "quantitative"] },
        "aggregation": { "type": "string" },
        "defaultFormat": { "type": "string" },
        "semanticRole": { "type": "string" },
        "hidden": { "type": "boolean" },
        "folder": { "type": "string" },
        "description": { "type": "string" },
        "aliases": { "type": "object", "additionalProperties": { "type": "string" } },
        "calculation": { "$ref": "#/$defs/calculation" },
        "param": {
          "description": "Parameter domain, for columns of the Parameters data source.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "domain": { "enum": ["list", "range", "any"] },
            "members": { "type": "array" },
            "range": { "type": "object" },
            "value": {}
          }
        },
        "raw": { "$ref": "#/$defs/raw" }
      }
    },
    "datasource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind"],
      "properties": {
        "name": { "description": "Internal name, e.g. federated.0a1b2c3.", "type": "string" },
        "caption": { "type": "string" },
        "kind": { "enum": ["embedded", "published", "parameters"] },
        "published": {
          "description": "For workbooks that use a published data source (sqlproxy).",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "contentUrl": { "type": "string" },
            "siteContentUrl": { "type": "string" },
            "luid": { "type": "string" }
          }
        },
        "connection": { "$ref": "#/$defs/connection" },
        "namedConnections": { "type": "array", "items": { "$ref": "#/$defs/connection" } },
        "relation": { "$ref": "#/$defs/relation" },
        "objectGraph": { "$ref": "#/$defs/objectGraph" },
        "columns": { "type": "array", "items": { "$ref": "#/$defs/column" } },
        "drillPaths": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "fields"],
            "properties": { "name": { "type": "string" }, "fields": { "type": "array", "items": { "type": "string" } } }
          }
        },
        "groups": { "description": "Groups and sets (Tableau <group> elements).", "type": "array", "items": { "type": "object" } },
        "filters": { "description": "Data source filters.", "type": "array", "items": { "type": "object" } },
        "extract": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "file": { "description": "Path of the .hyper/.tde inside the package.", "type": "string" },
            "refresh": { "type": "object" },
            "incrementalKey": { "type": "string" },
            "filters": { "type": "array", "items": { "type": "object" } },
            "aggregated": { "type": "boolean" },
            "raw": { "$ref": "#/$defs/raw" }
          }
        },
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "weekStart": { "type": "string" },
            "fiscalYearStart": { "type": "string" },
            "dateFormat": { "type": "string" }
          }
        }
      }
    },
    "fieldInstance": {
      "description": "A field as used on a sheet, e.g. [federated.x].[sum:Sales:qk].",
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "datasource", "field", "derivation"],
      "properties": {
        "ref": { "type": "string" },
        "datasource": { "type": "string" },
        "field": { "type": "string" },
        "derivation": { "description": "none, sum, avg, cnt, ctd, attr, usr, yr, qr, mn, dy, tmn, tdy, ...", "type": "string" },
        "pivot": { "type": "string" },
        "kind": { "description": "qk = quantitative, nk = nominal, ok = ordinal.", "enum": ["qk", "nk", "ok"] },
        "tableCalc": { "description": "Raw <table-calc> attributes for quick table calculations.", "type": "object" }
      }
    },
    "shelf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expr"],
      "properties": {
        "expr": { "description": "Shelf expression as written in the XML (with / for nest, + for concatenation, * for cross).", "type": "string" },
        "instances": { "type": "array", "items": { "type": "string" } },
        "tree": { "description": "Parsed nest/cross/concatenate tree.", "type": "object" }
      }
    },
    "encodings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "color": { "type": "array", "items": { "type": "string" } },
        "size": { "type": "array", "items": { "type": "string" } },
        "text": { "type": "array", "items": { "type": "string" } },
        "lod": { "type": "array", "items": { "type": "string" } },
        "tooltip": { "type": "array", "items": { "type": "string" } },
        "shape": { "type": "array", "items": { "type": "string" } },
        "path": { "type": "array", "items": { "type": "string" } },
        "angle": { "type": "array", "items": { "type": "string" } },
        "wedgeSize": { "type": "array", "items": { "type": "string" } },
        "geometry": { "type": "array", "items": { "type": "string" } }
      }
    },
    "pane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["markClass"],
      "properties": {
        "id": { "type": "string" },
        "markClass": {
          "enum": [
            "Automatic", "Text", "Icon", "Shape", "Rectangle", "Bar", "GanttBar", "Square", "Circle",
            "Heatmap", "PolyLine", "Line", "Polygon", "Area", "Pie", "Multipolygon", "VizExtension"
          ]
        },
        "encodings": { "$ref": "#/$defs/encodings" },
        "axis": { "type": "object" },
        "raw": { "$ref": "#/$defs/raw" }
      }
    },
    "worksheetFilter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "class"],
      "properties": {
        "field": { "description": "Field instance reference.", "type": "string" },
        "class": { "enum": ["categorical", "quantitative", "relative-date"] },
        "context": { "type": "boolean" },
        "members": { "type": "array" },
        "exclude": { "type": "boolean" },
        "min": {},
        "max": {},
        "includeNulls": { "type": "boolean" },
        "period": { "type": "string" },
        "firstPeriod": { "type": "integer" },
        "lastPeriod": { "type": "integer" },
        "anchor": { "type": "string" },
        "topN": { "type": "object" },
        "condition": { "type": "string" },
        "wildcard": { "type": "object" },
        "raw": { "$ref": "#/$defs/raw" }
      }
    },
    "worksheet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "datasources", "panes"],
      "properties": {
        "name": { "type": "string" },
        "title": { "type": "string" },
        "hidden": { "description": "Hidden sheets have no view on Tableau Server.", "type": "boolean" },
        "datasources": { "type": "array", "items": { "type": "string" } },
        "dependencies": {
          "description": "Columns used per data source (datasource-dependencies).",
          "type": "object",
          "additionalProperties": { "type": "array", "items": { "type": "string" } }
        },
        "fieldInstances": { "type": "array", "items": { "$ref": "#/$defs/fieldInstance" } },
        "rows": { "$ref": "#/$defs/shelf" },
        "cols": { "$ref": "#/$defs/shelf" },
        "pages": { "$ref": "#/$defs/shelf" },
        "panes": { "type": "array", "items": { "$ref": "#/$defs/pane" } },
        "filters": { "type": "array", "items": { "$ref": "#/$defs/worksheetFilter" } },
        "sorts": { "type": "array", "items": { "type": "object" } },
        "totals": { "type": "object" },
        "style": { "$ref": "#/$defs/raw" }
      }
    },
    "zone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "x", "y", "w", "h"],
      "properties": {
        "id": { "type": "string" },
        "type": {
          "description": "layout-flow, layout-basic, viz, text, bitmap, web, filter, paramctrl, color, size, shape, map, title, empty, extension, button, ...",
          "type": "string"
        },
        "name": { "type": "string" },
        "worksheet": { "type": "string" },
        "x": { "description": "Tableau zone units: 0..100000 across the dashboard.", "type": "integer" },
        "y": { "type": "integer" },
        "w": { "type": "integer" },
        "h": { "type": "integer" },
        "floating": { "type": "boolean" },
        "hidden": { "type": "boolean" },
        "layout": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "direction": { "enum": ["horz", "vert"] },
            "distribute": { "type": "boolean" }
          }
        },
        "field": { "description": "For filter, parameter and legend zones.", "type": "string" },
        "param": { "type": "string" },
        "mode": { "description": "Filter control style, e.g. dropdown, checkdropdown, slider.", "type": "string" },
        "text": { "type": "string" },
        "image": { "type": "string" },
        "url": { "type": "string" },
        "style": { "$ref": "#/$defs/raw" },
        "children": { "type": "array", "items": { "$ref": "#/$defs/zone" } }
      }
    },
    "dashboardSize": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["fixed", "range", "automatic"] },
        "width": { "type": "integer" },
        "height": { "type": "integer" },
        "minWidth": { "type": "integer" },
        "minHeight": { "type": "integer" },
        "maxWidth": { "type": "integer" },
        "maxHeight": { "type": "integer" }
      }
    },
    "dashboard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "zones"],
      "properties": {
        "name": { "type": "string" },
        "title": { "type": "string" },
        "size": { "$ref": "#/$defs/dashboardSize" },
        "zones": { "type": "array", "items": { "$ref": "#/$defs/zone" } },
        "deviceLayouts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["device", "zones"],
            "properties": {
              "device": { "enum": ["desktop", "tablet", "phone"] },
              "size": { "$ref": "#/$defs/dashboardSize" },
              "zones": { "type": "array", "items": { "$ref": "#/$defs/zone" } }
            }
          }
        },
        "style": { "$ref": "#/$defs/raw" }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string" },
        "caption": { "type": "string" },
        "type": { "enum": ["filter", "highlight", "url", "sheet-navigate", "edit-parameter", "edit-group", "unknown"] },
        "trigger": { "enum": ["select", "hover", "menu"] },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "dashboard": { "type": "string" },
            "worksheets": { "type": "array", "items": { "type": "string" } }
          }
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "dashboard": { "type": "string" },
            "worksheets": { "type": "array", "items": { "type": "string" } },
            "url": { "type": "string" },
            "parameter": { "type": "string" },
            "set": { "type": "string" }
          }
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "target"],
            "properties": { "source": { "type": "string" }, "target": { "type": "string" } }
          }
        },
        "clear": { "type": "string" },
        "command": { "description": "Raw command, e.g. tsc:tsl-filter.", "type": "string" },
        "params": { "$ref": "#/$defs/raw" }
      }
    },
    "story": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "points"],
      "properties": {
        "name": { "type": "string" },
        "points": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "caption": { "type": "string" },
              "target": { "description": "Dashboard or worksheet name.", "type": "string" },
              "state": { "type": "object" }
            }
          }
        }
      }
    },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "message"],
      "properties": {
        "level": { "enum": ["info", "warning", "unsupported"] },
        "path": { "description": "Location in the source XML.", "type": "string" },
        "message": { "type": "string" }
      }
    }
  }
}
